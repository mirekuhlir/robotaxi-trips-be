// robotaxitrips.com — PostgreSQL schema
// Source: docs/database/ (viz docs/database/README.md)
// https://dbdiagram.io

Project robotaxitrips {
  database_type: 'PostgreSQL'
  Note: '''
    Plánování itinerářů a výletů s integrací autonomní dopravy.
    Plně relační schéma — bez JSONB.
    Cache na trips: total_cost_usd, total_cost_home, total_duration_minutes, recommended_age_*,
    max_difficulty, temp_*, rating_avg/rating_count, packing_computed_at + trip_packing_items,
    travel_requirements_computed_at + trip_travel_requirements,
    robotaxi_advisories_computed_at + trip_robotaxi_advisories.
    Cache na places: review_rating_avg/review_rating_count (UGC); places.rating = externí Maps.
    Diagramový zdroj pro dbdiagram.io; SQL migrace se píšou ručně podle .md.
    CHECK, partial indexy, ON DELETE akce a exclusion constrainty jsou v DBML jen poznámkami.
    Unique indexy označené jako partial nesmí být z DBML generované jako běžné globální UNIQUE.
  '''
}

// ─── ENUM typy ───────────────────────────────────────────────

Enum trip_status {
  draft
  published
}

Enum trip_visibility {
  private
  unlisted
  public
}

Enum member_role {
  admin
  editor
  viewer
}

Enum segment_difficulty {
  easy
  moderate
  hard
  extreme [note: 'Pořadí = rostoucí náročnost pro MAX()']
}

Enum segment_kind {
  accommodation
  activity
  transit
}

Enum transport_mode {
  walk
  robotaxi
  own_car
  car_rental
  rideshare
  bus
  tram
  metro
  train
  plane
  helicopter
  boat
  bicycle
  bike_share
  scooter
  motorcycle
  cable_car
  other
}

Enum robotaxi_service_status {
  waitlist
  public
  suspended
}

Enum robotaxi_advisory_severity {
  info
  warning
}

Enum precipitation_intensity {
  none
  drizzle
  light
  moderate
  heavy
  storm
}

Enum sky_condition {
  clear
  mostly_sunny
  partly_cloudy
  mostly_cloudy
  cloudy
  overcast
  variable
}

Enum wind_force {
  calm
  light
  moderate
  fresh
  strong
  gale
  storm
}

Enum fog_condition {
  none
  haze
  mist
  fog
  dense_fog
}

Enum clothing_category {
  outerwear
  layering
  footwear
  accessories
  protection
}

Enum packing_source {
  weather
  segment
}

Enum travel_requirement_source {
  trip_geography
  manual
}

Enum weather_region_type {
  postal_code
  locality
  subdivision [note: 'Stát/kraj/provincie dle ISO 3166-2']
  custom
}

Enum review_media_kind {
  image
  video
}

Enum place_accepted_payments {
  card [note: 'Jen platba kartou']
  cash [note: 'Jen hotovost']
  card_and_cash [note: 'Karta i hotovost']
}

// ─── Uživatelé a výlety ──────────────────────────────────────

TableGroup core_trips {
  users
  trips
  trip_members
  trip_reviews
  trip_review_media
  trip_packing_items
  trip_packing_item_sources
  trip_travel_requirements
  trip_travel_requirement_sources
  segment_robotaxi_advisories
  trip_robotaxi_advisories
  segments
  segment_images
  segment_packing_items
  transit_details
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar [unique, not null]
  first_name varchar
  last_name varchar
  display_name varchar
  avatar_url text
  timezone varchar [not null, default: 'UTC']
  locale varchar [not null, default: 'en']
  home_currency char(3) [not null, default: 'USD', note: 'ISO 4217 uppercase; výchozí plánovací měna; CHECK ^[A-Z]{3}$']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    created_at [name: 'idx_users_created_at']
  }
}

Table trips {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by uuid [not null, ref: > users.id, note: 'Audit — ON DELETE RESTRICT, neměnný']
  title varchar [not null]
  description text
  cover_image_url text
  status trip_status [not null, default: 'draft']
  visibility trip_visibility [not null, default: 'private', note: 'private = jen členové; unlisted/public čitelné přes UUID podle pravidel v .md']
  home_currency char(3) [not null, default: 'USD', note: 'Plánovací měna výletu; ISO 4217 uppercase; CHECK ^[A-Z]{3}$']
  total_cost_usd numeric(10,2) [not null, default: 0, note: 'Cache SUM(segments.price_usd) — kanon pro katalog']
  total_cost_home numeric(10,2) [not null, default: 0, note: 'Cache SUM(segments.home_price_amount) v home_currency']
  total_duration_minutes integer [not null, default: 0, note: 'Cache — bez accommodation']
  recommended_age_min smallint [note: 'Cache MAX z aktivit']
  recommended_age_max smallint [note: 'Cache MIN z aktivit']
  max_difficulty segment_difficulty [note: 'Cache MAX z aktivit']
  temp_min_c numeric(4,1) [note: 'Cache vzduchové teploty z weather_records']
  temp_max_c numeric(4,1) [note: 'Cache vzduchové teploty z weather_records']
  feels_like_min_c numeric(4,1) [note: 'Cache pocitové teploty z weather_records; primární katalogový filtr']
  feels_like_max_c numeric(4,1) [note: 'Cache pocitové teploty z weather_records; primární katalogový filtr']
  rating_avg numeric(2,1) [note: 'Cache AVG(trip_reviews.score); NULL při rating_count = 0; CHECK 1–5']
  rating_count integer [not null, default: 0, note: 'Cache COUNT(trip_reviews); CHECK >= 0; count 0 ⇔ avg NULL']
  packing_computed_at timestamptz [note: 'Čas posledního přepočtu cache balení']
  travel_requirements_computed_at timestamptz [note: 'Čas posledního přepočtu cache cestovních požadavků']
  robotaxi_advisories_computed_at timestamptz [note: 'Čas posledního přepočtu cache robotaxi upozornění']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    created_by [name: 'idx_trips_created_by']
    visibility [name: 'idx_trips_visibility']
    (status, visibility) [name: 'idx_trips_status_visibility', note: 'Pokrývá i samostatný filtr dle status (leading sloupec)']
    total_cost_usd [name: 'idx_trips_total_cost_usd']
    total_cost_home [name: 'idx_trips_total_cost_home', note: 'Řazení mých výletů v home měně; ne pro veřejný katalog']
    total_duration_minutes [name: 'idx_trips_total_duration_minutes']
    (recommended_age_min, recommended_age_max) [name: 'idx_trips_recommended_age']
    max_difficulty [name: 'idx_trips_max_difficulty']
    (temp_min_c, temp_max_c) [name: 'idx_trips_temp']
    (feels_like_min_c, feels_like_max_c) [name: 'idx_trips_feels_like']
    rating_avg [name: 'idx_trips_rating_avg']
  }
}

Table trip_members {
  trip_id uuid [pk, ref: > trips.id, note: 'ON DELETE CASCADE']
  user_id uuid [pk, ref: > users.id, note: 'ON DELETE CASCADE']
  role member_role [not null, default: 'viewer']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    user_id [name: 'idx_trip_members_user_id']
  }

  Note: 'Jediný zdroj pravdy pro oprávnění. Min. 1 admin per trip (aplikace).'
}

Table trip_reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null, ref: > trips.id, note: 'ON DELETE CASCADE']
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE RESTRICT; autor recenze']
  score smallint [not null, note: 'CHECK BETWEEN 1 AND 5']
  body text [note: 'UGC v jazyce autora; prázdný řetězec → NULL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (trip_id, user_id) [unique, name: 'uq_trip_reviews_trip_user']
    user_id [name: 'idx_trip_reviews_user_id']
    (trip_id, created_at) [name: 'idx_trip_reviews_trip_created_at']
  }

  Note: 'Uživatelská recenze výletu. Agregace → trips.rating_avg / rating_count. Jen published; created_by nesmí hodnotit vlastní výlet (aplikace).'
}

Table trip_review_media {
  id uuid [pk, default: `gen_random_uuid()`]
  review_id uuid [not null, ref: > trip_reviews.id, note: 'ON DELETE CASCADE']
  media_kind review_media_kind [not null]
  media_url text [not null, note: 'HTTPS CDN/R2/S3; stejný pattern jako segment_images']
  poster_url text [note: 'Jen video; u image vždy NULL; HTTPS']
  caption text [note: 'Prázdný řetězec → NULL']
  sort_order smallint [not null, default: 0, note: 'CHECK >= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (review_id, sort_order) [name: 'idx_trip_review_media_review_sort']
  }

  Note: 'Galerie médií recenze. CHECK: image ⇒ poster_url NULL. Max. počet per recenze v aplikaci (např. 10).'
}

Table trip_packing_items {
  trip_id uuid [pk, ref: > trips.id, note: 'ON DELETE CASCADE']
  clothing_item_id uuid [pk, ref: > clothing_items.id, note: 'ON DELETE RESTRICT']
  priority smallint [not null, note: 'Priorita z matching clothing_rules']

  Note: 'Agregovaná cache balení na úrovni výletu.'
}

Table trip_packing_item_sources {
  trip_id uuid [pk]
  clothing_item_id uuid [pk]
  source packing_source [pk]

  Note: 'Proč byla položka doporučena: weather / segment (smíšené pravidlo přispívá oběma zdroji). Composite FK na trip_packing_items. Bez sloupce priority (záměrně) — oba zdroje se při přepočtu plně regenerují; efektivní priorita je v trip_packing_items.'
}

Table trip_travel_requirements {
  trip_id uuid [pk, ref: > trips.id, note: 'ON DELETE CASCADE']
  travel_requirement_item_id uuid [pk, ref: > travel_requirement_items.id, note: 'ON DELETE RESTRICT']
  priority smallint [not null, note: 'Efektivní priorita = max(geo pravidlo, manual)']

  Note: 'Agregovaná cache cestovních požadavků na úrovni výletu. Při odebrání geo zdroje zůstává manual priorita, pokud existuje.'
}

Table trip_travel_requirement_sources {
  trip_id uuid [pk]
  travel_requirement_item_id uuid [pk]
  source travel_requirement_source [pk]
  priority smallint [not null, note: 'Priorita daného zdroje; trip_travel_requirements.priority = max přes zdroje']

  Note: 'Proč byla položka doporučena: trip_geography / manual. Composite FK na trip_travel_requirements.'
}

Ref: trip_packing_item_sources.(trip_id, clothing_item_id) > trip_packing_items.(trip_id, clothing_item_id) [delete: cascade]

Ref: trip_travel_requirement_sources.(trip_id, travel_requirement_item_id) > trip_travel_requirements.(trip_id, travel_requirement_item_id) [delete: cascade]

// ─── Místa a počasí ──────────────────────────────────────────

TableGroup places_weather {
  place_categories
  weather_regions
  places
  place_reviews
  place_review_media
  weather_records
  weather_climate_months
}

Table place_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [unique, not null, note: 'Slug — viz seed v docs/database/02-places.md']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  Note: 'Seed: accommodation, landmark, culture_museum, restaurant_dining, shopping_retail, entertainment_sports, viewpoint, beach_waterfront, wellness_spa, nature_park, charging_fueling_hub, public_transport_terminal, airport, parking_lot, robotaxi_pickup_zone'
}

Table weather_regions {
  id uuid [pk, default: `gen_random_uuid()`]
  region_type weather_region_type [not null]
  name varchar [not null]
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2; CHECK ~ ^[A-Z]{2}$']
  subdivision_code varchar [note: 'ISO 3166-2 bez prefixu země; povinné pro locality i subdivision']
  subdivision_name varchar
  locality varchar
  postal_code varchar [note: 'Normalizované PSČ/ZIP bez mezer']
  timezone varchar [not null, note: 'IANA timezone pro lokální ISO týden počasí']
  center_latitude numeric(9,6) [not null, note: 'Weather API a geo fallback; CHECK BETWEEN -90 AND 90']
  center_longitude numeric(9,6) [not null, note: 'Weather API a geo fallback; CHECK BETWEEN -180 AND 180']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (country_code, postal_code) [unique, name: 'uq_weather_regions_postal', note: 'SQL: partial UNIQUE WHERE region_type = postal_code; DBML unique je pouze diagramová aproximace']
    (country_code, subdivision_code, locality) [unique, name: 'uq_weather_regions_locality', note: 'SQL: partial UNIQUE WHERE region_type = locality; subdivision_code povinné pro locality; DBML unique je pouze diagramová aproximace']
    (country_code, subdivision_code) [unique, name: 'uq_weather_regions_subdivision', note: 'SQL: partial UNIQUE WHERE region_type = subdivision; DBML unique je pouze diagramová aproximace — jako globální UNIQUE by kolidoval s locality regiony stejné subdivize (např. subdivision US/CA vs. locality US/CA/San Francisco a US/CA/Los Angeles)']
  }

  Note: 'region_type = custom záměrně bez unique constraintu — zakládá se ručně, unikátnost hlídá admin proces. CHECK country_code ~ ^[A-Z]{2}$.'
}

Table places {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [note: 'Nullable; prázdný řetězec → NULL']
  description text
  website_url text [note: 'HTTPS při vyplnění']
  address text
  phone_calling_code varchar [note: 'Mezinárodní předvolba bez +; CHECK IS NULL OR ~ ^[0-9]{1,3}$; ne ISO country_code']
  telephone varchar [note: 'Číslo bez předvolby; FE skládá +{phone_calling_code} {telephone}']
  accepted_payments place_accepted_payments [note: 'NULL = neznámé / nezadáno — UI nic nezobrazí; žádný CHECK ani index navíc']
  rating numeric(2,1) [note: 'Externí Google Maps–style import; CHECK IS NULL OR (rating >= 1 AND rating <= 5); NE agregace z place_reviews']
  review_rating_avg numeric(2,1) [note: 'Cache AVG(place_reviews.score); NULL při review_rating_count = 0; CHECK 1–5']
  review_rating_count integer [not null, default: 0, note: 'Cache COUNT(place_reviews); CHECK >= 0; count 0 ⇔ avg NULL']
  latitude numeric(9,6) [not null, note: 'CHECK BETWEEN -90 AND 90']
  longitude numeric(9,6) [not null, note: 'CHECK BETWEEN -180 AND 180']
  category_id uuid [not null, ref: > place_categories.id, note: 'ON DELETE RESTRICT']
  weather_region_id uuid [ref: > weather_regions.id, note: 'ON DELETE SET NULL; aplikace validuje shodu country_code']
  country_code char(2) [note: 'ISO 3166-1 alpha-2; NULL = neznámá země; CHECK IS NULL OR ~ ^[A-Z]{2}$']
  postal_code varchar [note: 'Normalizované PSČ/ZIP']
  subdivision_code varchar [note: 'ISO 3166-2 bez prefixu země']
  subdivision_name varchar
  locality varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (latitude, longitude) [name: 'idx_places_coordinates']
    weather_region_id [name: 'idx_places_weather_region_id']
    country_code [name: 'idx_places_country_code', note: 'SQL: partial WHERE country_code IS NOT NULL']
    (country_code, postal_code) [name: 'idx_places_postal_code', note: 'SQL: partial WHERE country_code IS NOT NULL AND postal_code IS NOT NULL']
    review_rating_avg [name: 'idx_places_review_rating_avg']
  }
}

Table place_reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  place_id uuid [not null, ref: > places.id, note: 'ON DELETE CASCADE']
  user_id uuid [not null, ref: > users.id, note: 'ON DELETE RESTRICT; autor recenze']
  score smallint [not null, note: 'CHECK BETWEEN 1 AND 5']
  body text [note: 'UGC v jazyce autora; prázdný řetězec → NULL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (place_id, user_id) [unique, name: 'uq_place_reviews_place_user']
    user_id [name: 'idx_place_reviews_user_id']
    (place_id, created_at) [name: 'idx_place_reviews_place_created_at']
  }

  Note: 'Uživatelská recenze místa. Agregace → places.review_rating_avg / review_rating_count. Oddělené od places.rating (Maps).'
}

Table place_review_media {
  id uuid [pk, default: `gen_random_uuid()`]
  review_id uuid [not null, ref: > place_reviews.id, note: 'ON DELETE CASCADE']
  media_kind review_media_kind [not null]
  media_url text [not null, note: 'HTTPS CDN/R2/S3']
  poster_url text [note: 'Jen video; u image vždy NULL; HTTPS']
  caption text [note: 'Prázdný řetězec → NULL']
  sort_order smallint [not null, default: 0, note: 'CHECK >= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (review_id, sort_order) [name: 'idx_place_review_media_review_sort']
  }

  Note: 'Galerie médií recenze místa. Stejný tvar jako trip_review_media.'
}

Table weather_records {
  id uuid [pk, default: `gen_random_uuid()`]
  weather_region_id uuid [not null, ref: > weather_regions.id, note: 'ON DELETE CASCADE']
  week_start date [not null, note: 'Pondělí lokálního ISO týdne dle weather_regions.timezone; CHECK ISODOW = 1']
  temp_avg_c numeric(4,1) [not null, note: 'Vzduchová teplota']
  temp_min_c numeric(4,1)
  temp_max_c numeric(4,1)
  humidity_avg_pct numeric(4,1) [note: 'Relativní vlhkost %; CHECK 0..100']
  feels_like_avg_c numeric(4,1) [note: 'Pocitová teplota (apparent temperature; prefer Open-Meteo)']
  feels_like_min_c numeric(4,1)
  feels_like_max_c numeric(4,1)
  sky_condition sky_condition [not null]
  sunshine_hours numeric(5,1)
  precipitation_intensity precipitation_intensity [not null]
  rain_mm numeric(6,1) [not null, default: 0]
  rainy_days smallint [not null, default: 0]
  wind_force wind_force [not null]
  wind_speed_avg_ms numeric(4,1)
  wind_speed_max_ms numeric(4,1)
  wind_direction_avg_deg smallint
  fog_condition fog_condition [not null]
  fog_days smallint [not null, default: 0]
  visibility_avg_m integer
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (weather_region_id, week_start) [unique, name: 'uq_weather_records_region_week']
    week_start [name: 'idx_weather_records_week_start']
  }

  Note: '''
    CHECK: precipitation_intensity = none => rain_mm = 0 AND rainy_days = 0;
    fog_condition = none => fog_days = 0;
    sunshine_hours IS NULL OR (0..168);
    visibility_avg_m IS NULL OR >= 0;
    wind_speed_* >= 0; avg <= max when both set;
    temp_avg_c between temp_min_c and temp_max_c when both set;
    humidity_avg_pct IS NULL OR (0..100);
    feels_like_* same bounds as temp_* (-90..60); min <= max; avg between min and max when all set.
    DB nepočítá pocitovou teplotu — ukládá hodnoty z ingestu / aplikace.
  '''
}

Table weather_climate_months {
  id uuid [pk, default: `gen_random_uuid()`]
  weather_region_id uuid [not null, ref: > weather_regions.id, note: 'ON DELETE CASCADE']
  month smallint [not null, note: 'Kalendářní měsíc 1–12; CHECK BETWEEN 1 AND 12']
  temp_avg_c numeric(4,1) [not null, note: 'Typická průměrná vzduchová teplota']
  temp_min_c numeric(4,1) [note: 'Typické vzduchové minimum']
  temp_max_c numeric(4,1) [note: 'Typické vzduchové maximum']
  humidity_avg_pct numeric(4,1) [note: 'Typická relativní vlhkost %; CHECK 0..100']
  feels_like_avg_c numeric(4,1) [note: 'Typická pocitová teplota (apparent temperature)']
  feels_like_min_c numeric(4,1)
  feels_like_max_c numeric(4,1)
  sky_condition sky_condition [not null]
  sunshine_hours numeric(5,1) [note: 'Typický součet hodin slunce za měsíc']
  precipitation_intensity precipitation_intensity [not null]
  rain_mm numeric(6,1) [not null, default: 0]
  rainy_days smallint [not null, default: 0, note: 'CHECK BETWEEN 0 AND 31']
  wind_force wind_force [not null]
  fog_condition fog_condition [not null]
  fog_days smallint [not null, default: 0, note: 'CHECK BETWEEN 0 AND 31']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (weather_region_id, month) [unique, name: 'uq_weather_climate_months_region_month']
  }

  Note: '''
    Měsíční klimatický normál (typický měsíc, ne konkrétní rok). Skóre / suitability ideálního měsíce se neperzistuje — odvozenina v aplikaci (teplotní pásmo na feels_like_*).
    CHECK: precipitation_intensity = none => rain_mm = 0 AND rainy_days = 0;
    fog_condition = none => fog_days = 0;
    sunshine_hours IS NULL OR (0..744);
    temp_avg_c between temp_min_c and temp_max_c when both set;
    humidity_avg_pct IS NULL OR (0..100);
    feels_like_* same bounds as temp_* (-90..60); min <= max; avg between min and max when all set.
  '''
}

// ─── Oblečení a pravidla ─────────────────────────────────────

TableGroup clothing {
  clothing_items
  clothing_rules
  clothing_rule_precipitation_intensities
  clothing_rule_wind_forces
  clothing_rule_fog_conditions
  clothing_rule_sky_conditions
  clothing_rule_difficulties
}

Table clothing_items {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar [unique, not null, note: 'light_jacket, umbrella, …']
  category clothing_category [not null]
  sort_order smallint [not null, note: 'CHECK >= 0']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    category [name: 'idx_clothing_items_category']
    is_active [name: 'idx_clothing_items_active', note: 'SQL: partial WHERE is_active = true']
  }
}

Table clothing_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  clothing_item_id uuid [not null, ref: > clothing_items.id, note: 'ON DELETE CASCADE']
  priority smallint [not null, default: 0]
  temp_avg_c_lte numeric(4,1)
  temp_avg_c_gte numeric(4,1)
  temp_min_c_lte numeric(4,1)
  temp_min_c_gte numeric(4,1)
  temp_max_c_lte numeric(4,1)
  temp_max_c_gte numeric(4,1)
  feels_like_avg_c_lte numeric(4,1)
  feels_like_avg_c_gte numeric(4,1)
  feels_like_min_c_lte numeric(4,1)
  feels_like_min_c_gte numeric(4,1)
  feels_like_max_c_lte numeric(4,1)
  feels_like_max_c_gte numeric(4,1)
  rainy_days_gte smallint
  min_duration_minutes_gte integer
  non_accommodation_activity boolean [note: 'true = jen activity mimo accommodation na start_place']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    clothing_item_id [name: 'idx_clothing_rules_item_id']
    is_active [name: 'idx_clothing_rules_active', note: 'SQL: partial WHERE is_active = true']
  }

  Note: 'AND logika mezi skalárními sloupci; IN logika v junction tabulkách. Pokud je vyplněn alespoň jeden feels_like_* práh, matchují se jen pocitové podmínky (temp_* na stejném pravidle se ignorují); jinak vzduchové temp_*. Fallback pocitové hodnoty ve weather_records: feels_like_* → temp_*. CHECK: *_gte <= *_lte když jsou obě vyplněné.'
}

Table clothing_rule_precipitation_intensities {
  clothing_rule_id uuid [pk, ref: > clothing_rules.id, note: 'ON DELETE CASCADE']
  precipitation_intensity precipitation_intensity [pk]
}

Table clothing_rule_wind_forces {
  clothing_rule_id uuid [pk, ref: > clothing_rules.id, note: 'ON DELETE CASCADE']
  wind_force wind_force [pk]
}

Table clothing_rule_fog_conditions {
  clothing_rule_id uuid [pk, ref: > clothing_rules.id, note: 'ON DELETE CASCADE']
  fog_condition fog_condition [pk]
}

Table clothing_rule_sky_conditions {
  clothing_rule_id uuid [pk, ref: > clothing_rules.id, note: 'ON DELETE CASCADE']
  sky_condition sky_condition [pk]
}

Table clothing_rule_difficulties {
  clothing_rule_id uuid [pk, ref: > clothing_rules.id, note: 'ON DELETE CASCADE']
  segment_difficulty segment_difficulty [pk]
}

// ─── Cestovní požadavky ──────────────────────────────────────

TableGroup travel_requirements {
  travel_requirement_items
  travel_requirement_rules
}

Table travel_requirement_items {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar [unique, not null, note: 'passport, visa, national_id, …']
  sort_order smallint [not null, note: 'CHECK >= 0']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    is_active [name: 'idx_travel_requirement_items_active', note: 'SQL: partial WHERE is_active = true']
  }
}

Table travel_requirement_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  travel_requirement_item_id uuid [not null, ref: > travel_requirement_items.id, note: 'ON DELETE CASCADE']
  priority smallint [not null, default: 0]
  min_distinct_countries_gte smallint [note: 'Match když výlet protíná ≥ N různých country_code']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    travel_requirement_item_id [name: 'idx_travel_requirement_rules_item_id']
    is_active [name: 'idx_travel_requirement_rules_active', note: 'SQL: partial WHERE is_active = true']
  }

  Note: 'Pravidla na úrovni výletu — odvozena z geografie míst segmentů.'
}

// ─── Robotaxi ──────────────────────────────────────────────────

TableGroup robotaxi {
  robotaxi_providers
  robotaxi_vehicle_models
  provider_service_areas
  robotaxi_advisory_items
  robotaxi_advisory_rules
  robotaxi_advisory_rule_fog_conditions
  robotaxi_advisory_rule_precipitation_intensities
  robotaxi_advisory_rule_wind_forces
}

Table robotaxi_providers {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar [unique, not null, note: 'waymo, tesla, zoox, …']
  name varchar [not null]
  website_url text
  app_deeplink_url text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    is_active [name: 'idx_robotaxi_providers_active', note: 'SQL: partial WHERE is_active = true']
  }

  Note: 'Seed: waymo, tesla, zoox, cruise, apollo_go, weride, pony_ai, motional, other'
}

Table robotaxi_vehicle_models {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > robotaxi_providers.id, note: 'ON DELETE CASCADE']
  slug varchar [not null, note: 'jaguar_i_pace, zoox_pod, …']
  name varchar [not null, note: 'Jaguar I-Pace, Zoox pod, …']
  seat_count smallint [not null, note: 'CHECK >= 1']
  wheelchair_accessible boolean [not null, default: false]
  child_seat_available boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (provider_id, slug) [unique, name: 'uq_robotaxi_vehicle_models_provider_slug']
    provider_id [name: 'idx_robotaxi_vehicle_models_provider_id']
    is_active [name: 'idx_robotaxi_vehicle_models_active', note: 'SQL: partial WHERE is_active = true']
  }
}

Table provider_service_areas {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > robotaxi_providers.id, note: 'ON DELETE CASCADE']
  name varchar [not null, note: 'San Francisco, Phoenix, …']
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2; CHECK ~ ^[A-Z]{2}$']
  subdivision_code varchar [not null, note: 'ISO 3166-2 bez prefixu země']
  subdivision_name varchar
  locality varchar [not null, note: 'Město / obec']
  status robotaxi_service_status [not null, default: 'waitlist']
  launched_at date
  operates_24_7 boolean [not null, default: true]
  daily_start_local time [note: 'Povinné když operates_24_7 = false']
  daily_end_local time [note: 'Povinné když operates_24_7 = false']
  serves_airport boolean [not null, default: false]
  allows_highway boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (provider_id, country_code, subdivision_code, locality) [unique, name: 'uq_provider_service_areas_geo']
    provider_id [name: 'idx_provider_service_areas_provider_id']
    status [name: 'idx_provider_service_areas_status']
    (country_code, subdivision_code, locality) [name: 'idx_provider_service_areas_locality']
  }

  Note: 'Geofence na úrovni locality; polygon geofence (PostGIS) backlog v2. CHECK country_code ~ ^[A-Z]{2}$.'
}

Table robotaxi_advisory_items {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar [unique, not null, note: 'dense_fog_disruption, storm_disruption, …']
  severity robotaxi_advisory_severity [not null]
  sort_order smallint [not null, note: 'CHECK >= 0']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    is_active [name: 'idx_robotaxi_advisory_items_active', note: 'SQL: partial WHERE is_active = true']
  }
}

Table robotaxi_advisory_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  advisory_item_id uuid [not null, ref: > robotaxi_advisory_items.id, note: 'ON DELETE CASCADE']
  priority smallint [not null, default: 0]
  visibility_avg_m_lte integer [note: 'Match proti weather_records.visibility_avg_m']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    advisory_item_id [name: 'idx_robotaxi_advisory_rules_item_id']
    is_active [name: 'idx_robotaxi_advisory_rules_active', note: 'SQL: partial WHERE is_active = true']
  }

  Note: 'AND logika mezi skalárními sloupci; IN logika v junction tabulkách. Vyhodnocení jen pro transit + robotaxi.'
}

Table robotaxi_advisory_rule_fog_conditions {
  advisory_rule_id uuid [pk, ref: > robotaxi_advisory_rules.id, note: 'ON DELETE CASCADE']
  fog_condition fog_condition [pk]
}

Table robotaxi_advisory_rule_precipitation_intensities {
  advisory_rule_id uuid [pk, ref: > robotaxi_advisory_rules.id, note: 'ON DELETE CASCADE']
  precipitation_intensity precipitation_intensity [pk]
}

Table robotaxi_advisory_rule_wind_forces {
  advisory_rule_id uuid [pk, ref: > robotaxi_advisory_rules.id, note: 'ON DELETE CASCADE']
  wind_force wind_force [pk]
}

// ─── Itinerář ────────────────────────────────────────────────

Table segments {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [not null, ref: > trips.id, note: 'ON DELETE CASCADE']
  segment_kind segment_kind [not null]
  start_time timestamptz [not null]
  end_time timestamptz [not null, note: 'CHECK end_time > start_time']
  start_place_id uuid [not null, ref: > places.id, note: 'ON DELETE RESTRICT']
  end_place_id uuid [ref: > places.id, note: 'ON DELETE RESTRICT; NULL u accommodation; u transit NOT NULL a smí = start_place_id (okružní jízda)']
  local_price_amount numeric(10,2) [not null, default: 0, note: 'Místní cena na destinaci; u accommodation cena přiřazená konkrétnímu úseku']
  local_price_currency char(3) [not null, default: 'USD', note: 'ISO 4217 uppercase; CHECK ^[A-Z]{3}$; u local_price_amount=0 uložit USD']
  exchange_rate_local_to_usd numeric(12,6) [not null, default: 1.0, note: 'Kurz local → USD; CHECK > 0']
  price_usd numeric(10,2) [not null, default: 0, note: 'ROUND(local_price_amount * exchange_rate_local_to_usd, 2)']
  home_price_amount numeric(10,2) [not null, default: 0, note: 'ROUND(local_price_amount * exchange_rate_local_to_home, 2)']
  exchange_rate_local_to_home numeric(12,6) [not null, default: 1.0, note: 'Kurz local → trips.home_currency; CHECK > 0']
  recommended_age_min smallint [note: 'Jen u activity']
  recommended_age_max smallint [note: 'Jen u activity']
  difficulty segment_difficulty [note: 'NULL u accommodation']
  title varchar [note: 'NULL = FE zobrazí places.name u start_place; pokud i name NULL → placeholder']
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (trip_id, start_time) [name: 'idx_segments_trip_start_time']
    start_place_id [name: 'idx_segments_start_place_id']
    end_place_id [name: 'idx_segments_end_place_id', note: 'SQL: partial WHERE end_place_id IS NOT NULL']
    segment_kind [name: 'idx_segments_segment_kind']
    difficulty [name: 'idx_segments_difficulty']
  }

  Note: '''
    Lineární timeline [start_time, end_time) — bez překryvů včetně accommodation.
    Produkční SQL přidá exclusion constraint přes btree_gist; DBML ho neumí vyjádřit.
    Vícedenní ubytování modeluj jako check-in/check-out nebo noční úseky.
    transit_details jen u segment_kind = transit.
  '''
}

Table segment_images {
  id uuid [pk, default: `gen_random_uuid()`]
  segment_id uuid [not null, ref: > segments.id, note: 'ON DELETE CASCADE']
  image_url text [not null]
  caption text
  sort_order smallint [not null, default: 0, note: 'CHECK >= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    (segment_id, sort_order) [name: 'idx_segment_images_segment_sort']
  }
}

Table segment_packing_items {
  segment_id uuid [pk, ref: > segments.id, note: 'ON DELETE CASCADE']
  clothing_item_id uuid [pk, ref: > clothing_items.id, note: 'ON DELETE RESTRICT']
  priority smallint [not null, note: 'Nejvyšší priorita matching clothing_rules pro segment a položku']

  Note: 'Cache doporučeného oblečení per segment; trip_packing_items bere max priority ze segmentů.'
}

Table segment_robotaxi_advisories {
  segment_id uuid [pk, ref: > segments.id, note: 'ON DELETE CASCADE']
  advisory_item_id uuid [pk, ref: > robotaxi_advisory_items.id, note: 'ON DELETE RESTRICT']
  priority smallint [not null, note: 'Nejvyšší priorita matching robotaxi_advisory_rules pro segment a položku']

  Note: 'Cache robotaxi upozornění per segment; trip_robotaxi_advisories bere max priority ze segmentů.'
}

Table trip_robotaxi_advisories {
  trip_id uuid [pk, ref: > trips.id, note: 'ON DELETE CASCADE']
  advisory_item_id uuid [pk, ref: > robotaxi_advisory_items.id, note: 'ON DELETE RESTRICT']
  priority smallint [not null, note: 'Max priority ze segment_robotaxi_advisories']

  Note: 'Agregovaná cache robotaxi upozornění na úrovni výletu.'
}

Table transit_details {
  segment_id uuid [pk, ref: - segments.id, note: '1:1 — ON DELETE CASCADE']
  transport_mode transport_mode [not null]
  provider_id uuid [ref: > robotaxi_providers.id, note: 'ON DELETE RESTRICT; u robotaxi povinné, jinak NULL']
  distance_meters integer [note: 'CHECK IS NULL OR >= 0']
  booking_reference varchar
  pickup_zone_place_id uuid [ref: > places.id, note: 'ON DELETE RESTRICT; jen robotaxi; kategorie robotaxi_pickup_zone']
  dropoff_zone_place_id uuid [ref: > places.id, note: 'ON DELETE RESTRICT; jen robotaxi; kategorie robotaxi_pickup_zone']
  estimated_wait_minutes smallint [note: 'CHECK IS NULL OR >= 0; jen robotaxi']
  passenger_count smallint [note: 'CHECK IS NULL OR >= 1; jen robotaxi']
  vehicle_model_id uuid [ref: > robotaxi_vehicle_models.id, note: 'ON DELETE RESTRICT; jen robotaxi; provider musí sedět s provider_id']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    transport_mode [name: 'idx_transit_details_transport_mode']
    provider_id [name: 'idx_transit_details_provider_id']
    vehicle_model_id [name: 'idx_transit_details_vehicle_model_id', note: 'SQL: partial WHERE vehicle_model_id IS NOT NULL']
    pickup_zone_place_id [name: 'idx_transit_details_pickup_zone', note: 'SQL: partial WHERE pickup_zone_place_id IS NOT NULL']
    dropoff_zone_place_id [name: 'idx_transit_details_dropoff_zone', note: 'SQL: partial WHERE dropoff_zone_place_id IS NOT NULL']
  }
}
