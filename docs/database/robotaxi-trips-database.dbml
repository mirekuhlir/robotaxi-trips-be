  name varchar [not null, note: 'San Francisco, Phoenix, …']
  country_code char(2) [not null, note: 'ISO 3166-1 alpha-2; CHECK ~ ^[A-Z]{2}$']
  subdivision_code varchar [not null, note: 'ISO 3166-2 bez prefixu země']
  subdivision_name varchar
  locality varchar [not null, note: 'Město / obec']
  status robotaxi_service_status [not null, default: 'waitlist']
