}

Table clothing_items {
  id uuid [pk, default: `gen_random_uuid()`]
  slug varchar [unique, not null, note: 'light_jacket, umbrella, …']
  category clothing_category [not null]
  sort_order smallint [not null, default: 0, note: 'CHECK >= 0']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    category [name: 'idx_clothing_items_category']
    is_active [name: 'idx_clothing_items_active', note: 'SQL: partial WHERE is_active = true']
  }
}

Table clothing_rules {
  id uuid [pk, default: `gen_random_uuid()`]
  clothing_item_id uuid [not null, ref: > clothing_items.id, note: 'ON DELETE CASCADE']
  priority smallint [not null, default: 0]
  temp_avg_c_lte numeric(4,1)
  temp_avg_c_gte numeric(4,1)
  temp_min_c_lte numeric(4,1)
  temp_min_c_gte numeric(4,1)
  temp_max_c_lte numeric(4,1)
  temp_max_c_gte numeric(4,1)
  feels_like_avg_c_lte numeric(4,1)
  feels_like_avg_c_gte numeric(4,1)
  feels_like_min_c_lte numeric(4,1)
  feels_like_min_c_gte numeric(4,1)
  feels_like_max_c_lte numeric(4,1)
  feels_like_max_c_gte numeric(4,1)
  rainy_days_gte smallint
  min_duration_minutes_gte integer
  non_accommodation_activity boolean [note: 'true = jen activity mimo accommodation na start_place; NULL = nevyhodnocovat; CHECK zakazuje false']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Auto-trigger']

  indexes {
    clothing_item_id [name: 'idx_clothing_rules_item_id']
    is_active [name: 'idx_clothing_rules_active', note: 'SQL: partial WHERE is_active = true']
  }

  Note: 'AND logika mezi skalárními sloupci; IN logika v junction tabulkách. Pokud je vyplněn alespoň jeden feels_like_* práh, matchují se jen pocitové podmínky (temp_* na stejném pravidle se ignorují); jinak vzduchové temp_*. Fallback pocitové hodnoty ve weather_records: feels_like_* → temp_*. Vyhodnocuje se jen proti weather_records, nikdy proti klimatu. CHECK: *_gte <= *_lte když jsou obě vyplněné; non_accommodation_activity IS NULL OR true.'
}

Table clothing_rule_precipitation_intensities {
